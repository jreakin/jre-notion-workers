# ── Dependencies & build output ───────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# NOTE: the tracked root dist/ is deliberately kept in git — it is the ONLY
# copy of the second-generation worker build whose TypeScript source was never
# committed, and some of its tools are LIVE in production. Ignoring `dist/`
# here does not untrack it (git only ignores untracked paths). Do not
# `git rm` it until the recovery in docs/ADR/0005-orphan-dist.md is complete.

# ── Secrets ───────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.1p

# ── Local agent/IDE state (per-developer, never shared) ───────────────
# settings.local.json has held a plaintext Notion PAT in a Bash allow-rule.
# Commit shared hooks/agents/settings.json; never commit local secrets or
# session ledgers.
.claude/settings.local.json
.claude/state/
.claude/handoffs/
.claude/command-log.txt
.claude/cross-agent-issues.json
.claude/code-reviewer-receipt.json
.claude/agent-config-audit-receipt.json
.claude/state/1p-pending.json
.abstract-data/pending-issues.jsonl
.abstract-data/session-confirmed.json
.abstract-data/transcripts/
.abstract-data/kv/
.cursor/hooks/state/

# ── OS noise ──────────────────────────────────────────────────────────
.DS_Store
.abstract-data/backups/
